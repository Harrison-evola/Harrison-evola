# Database
DATABASE_URL="postgresql://user:password@localhost:5432/listings_hub?schema=public"

# Default organization ID (used when auth is not yet integrated)
DEFAULT_ORG_ID="demo-org"

# App URL (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Business Profile OAuth
# 1. Create a project at https://console.cloud.google.com
# 2. Enable: My Business Business Information API, My Business Account Management API, Google My Business API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Yelp Fusion API
YELP_API_KEY=""

# Facebook Graph API
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Apple Maps / Business Connect
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
